# Build artifacts
/target/
/build/
# Per-crate target dirs (e.g. fuzz/ has its own workspace and target).
**/target/
fuzz/Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local artifacts (AI-generated, temp files, not for git)
.local/

# Local model fixtures pulled at runtime (e.g. by
# scripts/test-jetson-gpu.sh or scripts/download-test-fixtures.sh).
# Models are not source-of-truth and would balloon the repo.
/models/

# TLA+ model checker artifacts
states/
*_TTrace_*.bin
*_TTrace_*.tla

# Compiled device tree blobs (built from dts/ sources)
*.dtb

# Sphinx documentation build artifacts
docs/_build/

# Mutation testing output (cargo-mutants)
mutants.out/
mutants.out.old/

# Benchmark results (criterion output, not stored in git)
target/criterion/

# Fuzz corpus artifacts (generated by cargo-fuzz runs)
fuzz/artifacts/

# Coverage reports (generated locally)
lcov.info
lcov-*.info
sonar-coverage.xml

# Secrets (should never exist in this repo, but just in case)
*.pem
*.key
.env

# ONNX coverage probe fixture downloads (large; see
# tools/coverage-probe/REPORT.md for re-download instructions).
tests/fixtures/onnx-models/
